{
  "name": "addax-ui",
  "private": true,
  "version": "4.5.1-SNAPSHOT",
  "type": "module",
  "scripts": {
    "dev": "vite --force",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write 'src/**/*.{js,ts,vue,scss,css,json,md}'",
    "format:check": "prettier --check 'src/**/*.{js,ts,vue,scss,css,json,md}'"
  },
  "dependencies": {
    "@mdi/font": "7.4.47",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.21.1",
    "chart.js": "^4.6.1",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "marked": "^18.2.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.5.0",
    "vuetify": "^4.3.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tsconfig/node22": "^22.0.7",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.0",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.10.1",
    "sass-embedded": "^1.108.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "unplugin-vue-components": "^32.1.0",
    "unplugin-vue-router": "^0.19.2",
    "vite": "^8.3.8",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "lint-staged": {
    "**/*.{js,mjs,ts,vue}": [
      "prettier --write",
      "eslint --fix"
    ],
    "**/*.{scss,css,json,md}": [
      "prettier --write"
    ]
  },
  "description": "Addax management frontend",
  "main": "main.ts",
  "repository": "git@github.com:wgzhao/addax-admin.git",
  "author": "wgzhao <wgzhao@gmail.com>",
  "license": "Apache-2.0",
  "packageManager": "yarn@1.22.22+sha1.ac34549e6aa8e7ead463a7407e1c7390f61a6610"
}
